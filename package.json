{
	"name": "casadeguara",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run db:start && npm run services:wait:database && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run --project unit",
		"test:unit": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:integration": "npm run db:start && npm run services:wait:database && vitest run --project integration",
		"test:coverage": "npm run db:start && npm run services:wait:database && vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"services:wait:database": "node src/lib/scripts/wait-for-postgres.js",
		"db:start": "docker compose up -d",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/async-retry": "^1.4.9",
		"@types/eslint": "^9.6.1",
		"@types/validator": "^13.15.10",
		"@vitest/coverage-v8": "^4.1.10",
		"bulma": "^1.0.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.11.0",
		"lucia": "^3.2.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.102.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.5",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@types/qrcode": "^1.5.6",
		"argon2": "^0.45.1",
		"async-retry": "^1.3.3",
		"dayjs": "^1.11.21",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"extenso": "^3.0.0",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"uuid": "^14.0.1",
		"validator": "^13.15.35",
		"zod": "^4.4.3"
	}
}
